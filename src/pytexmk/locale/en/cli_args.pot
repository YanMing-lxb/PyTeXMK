#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:27
msgid ""
"\n"
"PyTeXMK-支持使用魔法注释来定义待编译主文件、编译程序、编译结果存放位置等（仅"
"支持检索文档前 50 行）\n"
msgstr ""
"\n"
"PyTeXMK supports using magic comments to define the main file to compile, "
"the compiler, and the output location of compilation results, etc. (only the "
"first 50 lines of the document are searched)\n"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:48
msgid "[i]LaTeX 辅助编译程序  ---- 焱铭[/]"
msgstr "[i]LaTeX auxiliary compilation tool  ---- YanMing[/]"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:50
msgid ""
"如欲了解魔法注释以及其他详细说明信息请运行 -r 参数，阅读 README 文件。发现 "
"BUG 请及时更新到最新版本，欢迎在 Github 仓库中提交 Issue：https://github.com/"
"YanMing-lxb/PyTeXMK/issues"
msgstr ""
"To learn about magic comments and other detailed information, run the -r "
"parameter to read the README file. If you find a BUG, please update to the "
"latest version promptly. You are welcome to submit an Issue in the Github "
"repository: https://github.com/YanMing-lxb/PyTeXMK/issues"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:64
msgid "显示 PyTeXMK 的版本号并退出"
msgstr "Show PyTeXMK's version number and exit"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:66
msgid "显示 PyTeXMK 的帮助信息并退出"
msgstr "Show PyTeXMK's help information and exit"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:67
msgid "显示README文件"
msgstr "Show the README file"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:69
msgid "PdfLaTeX 进行编译"
msgstr "Compile with PdfLaTeX"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:70
msgid "XeLaTeX 进行编译"
msgstr "Compile with XeLaTeX"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:71
msgid "LuaLaTeX 进行编译"
msgstr "Compile with LuaLaTeX"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:72
msgid "显式指定 TeX 引擎"
msgstr "Explicitly specify the TeX engine"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:80
msgid ""
"使用 LaTeXDiff 进行编译, 生成改动对比文件，当在配置文件中配置相关参数时可省"
"略 'OLD_FILE' 和 'NEW_FILE'"
msgstr ""
"Compile with LaTeXDiff to generate a diff file of changes. When relevant "
"parameters are configured in the configuration file, 'OLD_FILE' and "
"'NEW_FILE' can be omitted"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:89
msgid ""
"使用 LaTeXDiff 进行编译, 生成改动对比文件并编译新文件，当在配置文件中配置相关"
"参数时可省略 'OLD_FILE' 和 'NEW_FILE'"
msgstr ""
"Compile with LaTeXDiff to generate a diff file of changes and compile the "
"new file. When relevant parameters are configured in the configuration file, "
"'OLD_FILE' and 'NEW_FILE' can be omitted"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:92
msgid "启用草稿模式进行编译，提高编译速度 (无图显示)"
msgstr "Enable draft mode for compilation to increase compilation speed (no image display)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:94
msgid "清除所有主文件的辅助文件"
msgstr "Clean auxiliary files of all main files"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:96
msgid "清除所有主文件的辅助文件（包含根目录）和输出文件"
msgstr "Clean auxiliary files of all main files (including root directory) and output files"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:98
msgid "清除所有带辅助文件后缀的文件"
msgstr "Clean all files with auxiliary file extensions"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:100
msgid "清除所有带辅助文件后缀的文件（包含根目录）和主文件输出文件"
msgstr "Clean all files with auxiliary file extensions (including root directory) and main file output files"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:103
msgid "非安静模式运行, 此模式下终端显示日志信息"
msgstr "Run in non-quiet mode. In this mode, log information is displayed in the terminal"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:104
msgid "显示 PyTeXMK 运行过程中的详细信息"
msgstr "Show detailed information during PyTeXMK execution"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:110
msgid ""
"尝试修复所有根目录以外的 PDF 文件, 当 LaTeX 编译过程中警告 invalid X X R "
"object 时, 可使用此参数尝试修复所有 pdf 文件"
msgstr ""
"Attempt to repair all PDF files outside the root directory. When LaTeX "
"warns about invalid X X R object during compilation, you can use this "
"parameter to try to repair all pdf files"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:120
msgid ""
"尝试编译结束后调用 Web 浏览器或者本地 PDF 阅读器预览生成的PDF文件 (如需指定在"
"命令行中指定待编译主文件, 则 -pv 命令, 需放置 document 后面并无需指定参数, 示"
"例: pytexmk main -pv; 如无需在命令行中指定待编译主文件, 则直接输入 -pv 即可, "
"示例: pytexmk -pv), 如有填写 [dark_cyan]FILE_NAME[/dark_cyan] 则不进行编译打"
"开指定文件 (注意仅支持输出目录下的 PDF 文件, 示例: pytexmk -pv main)"
msgstr ""
"After compilation, try to invoke a Web browser or local PDF reader to "
"preview the generated PDF file (if you need to specify the main file to "
"compile on the command line, the -pv command must be placed after document "
"without specifying parameters, example: pytexmk main -pv; if you do not need "
"to specify the main file to compile on the command line, just enter -pv, "
"example: pytexmk -pv). If [dark_cyan]FILE_NAME[/dark_cyan] is provided, no "
"compilation is performed and the specified file is opened (note that only "
"PDF files in the output directory are supported, example: pytexmk -pv main)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:123
msgid "编译成功后自动打开 PDF 文件预览"
msgstr "Automatically open the PDF file preview after successful compilation"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:124
msgid "固定编译次数（默认2），同 --runs"
msgstr "Fixed number of compilation runs (default 2), same as --runs"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:125
msgid "输出目录，同 --outdir"
msgstr "Output directory, same as --outdir"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:127
msgid "指定参考文献工具"
msgstr "Specify the bibliography tool"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:128
msgid "指定索引工具"
msgstr "Specify the index tool"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:131
msgid "启用智能引擎自动判定（默认）"
msgstr "Enable smart engine auto-detection (default)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:132
msgid "禁用智能引擎自动判定"
msgstr "Disable smart engine auto-detection"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:134
msgid "编译超时时间（默认300秒）"
msgstr "Compilation timeout (default 300 seconds)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:135
msgid "固定编译次数（默认2，设为3时包含 bib 编译）"
msgstr "Fixed number of compilation runs (default 2, set to 3 to include bib compilation)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:136
msgid "输出目录（命令行覆盖魔法注释和配置）"
msgstr "Output directory (command line overrides magic comments and configuration)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:137
msgid "辅助文件目录"
msgstr "Auxiliary file directory"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:140
msgid "启用 SyncTeX（默认）"
msgstr "Enable SyncTeX (default)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:141
msgid "禁用 SyncTeX"
msgstr "Disable SyncTeX"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:145
msgid "启用 -shell-escape（默认）"
msgstr "Enable -shell-escape (default)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:148
msgid "禁用 -shell-escape"
msgstr "Disable -shell-escape"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:156
msgid "启用 PVC 模式（实时文件监听+自动编译），类似 latexmk -pvc"
msgstr "Enable PVC mode (real-time file watching + automatic compilation), similar to latexmk -pvc"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:159
msgid "PVC 模式文件变更防抖时间（默认1.0秒）"
msgstr "PVC mode file change debounce time (default 1.0 seconds)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:161
msgid "PVC 模式下编译成功自动打开预览"
msgstr "Automatically open preview after successful compilation in PVC mode"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:163
msgid "LaTeXDiff 时压平子文件（--flatten）"
msgstr "Flatten sub-files during LaTeXDiff (--flatten)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:164
msgid "LaTeXDiff 使用 --fast 模式"
msgstr "Use --fast mode for LaTeXDiff"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:165
msgid "LaTeXDiff 输出文件名"
msgstr "LaTeXDiff output file name"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:170
msgid "LaTeXDiff 显示风格：1-显示参考文献修改，2-不显示（默认2，非交互模式）"
msgstr "LaTeXDiff display style: 1-show bibliography changes, 2-do not show (default 2, non-interactive mode)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:174
msgid "非交互模式（不询问用户，自动处理，适合 CI/CD）"
msgstr "Non-interactive mode (does not ask the user, handles automatically, suitable for CI/CD)"

#: ⁨D:\Document YM\Desktop Document\Tools_Development\PyTeXMK\src\pytexmk\cli_args.py⁩:177
msgid "待编译主文件名"
msgstr "Main file name to compile"
