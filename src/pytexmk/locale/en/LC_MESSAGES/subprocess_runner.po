#, python-format
msgid "正在%(prog)s…"
msgstr "Running %(prog)s..."

#, python-format
msgid "系统临时目录不可写，本次编译改用 %(dir)s"
msgstr "The system temp directory is not writable; using %(dir)s for this build"

#, python-format
msgid "[√] 运行 %(prog)s 成功 [time](耗时: %(dur)s)[/]"
msgstr "[√] Ran %(prog)s successfully [time](took: %(dur)s)[/]"

#, python-format
msgid "%(prog)s 无法启动: %(err)s"
msgstr "%(prog)s failed to start: %(err)s"

msgid "无法发布重定向输出: "
msgstr "Failed to redirect output: "

#, python-format
msgid "已 %(sec)d 秒没有输出，%(prog)s 仍在运行（加 -nq 可看实时日志）"
msgstr ""
"No output for %(sec)d s; %(prog)s is still running (add -nq to see live "
"logs)"

#, python-format
msgid "%(prog)s 已结束，但输出管道仍未关闭（可能派生了后台进程），已停止等待；后续输出可能未收集"
msgstr ""
"%(prog)s has exited, but its output pipe is still open (a spawned process"
" may hold it); stopped waiting, later output may be incomplete"

#, python-format
msgid "[yellow]收到中断信号，正在终止 %(prog)s...[/yellow]"
msgstr "[yellow]Interrupt signal received, terminating %(prog)s...[/yellow]"

#, python-format
msgid "%(prog)s 编译失败, 请查看日志文件以获取详细信息: %(log)s"
msgstr "%(prog)s compilation failed, see the log file for details: %(log)s"

#, python-format
msgid "%(prog)s 执行失败 (退出码 %(code)s)"
msgstr "%(prog)s failed (exit code %(code)s)"

#~ msgid "[bold]运行命令: [/bold]"
#~ msgstr "[bold]Running command: [/bold]"

#~ msgid "%(prog)s 执行超时: "
#~ msgstr "%(prog)s execution timed out: "

#~ msgid "执行超时"
#~ msgstr "Execution timed out"

