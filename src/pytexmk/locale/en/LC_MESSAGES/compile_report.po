msgid "文献检测"
msgstr "Bib"

msgid "参考文献引用计数无变化，参考文献解析稳定"
msgstr "Bibliography stable"

msgid "需要额外执行编译以解析生成参考文献"
msgstr "Recompile for bibliography"

msgid "索引检测"
msgstr "Index"

msgid "索引词汇表内容未变动，索引生成稳定"
msgstr "Index stable"

msgid "索引文件存在变动，需要重新编译索引"
msgstr "Recompile index"

msgid "目录变化"
msgstr "TOC"

msgid "目录条目未发生变更，目录生成稳定"
msgstr "TOC stable"

msgid "目录内容发生变动，需要重新生成目录"
msgstr "Regenerate TOC"

msgid "交叉引用"
msgstr "Crossref"

msgid "交叉引用锚点未发生变更，引用解析稳定"
msgstr "Crossrefs stable"

msgid "辅助文件已发生变更，需再次编译解析引用关系"
msgstr "Recompile for refs"

msgid "书签文件"
msgstr "Bookmark"

msgid "PDF 书签条目未发生变更，书签生成稳定"
msgstr "Bookmarks stable"

msgid "PDF 书签信息发生变动，需要重新生成书签"
msgstr "Regenerate bookmarks"

msgid "日志信号"
msgstr "Log"

msgid "未检测到需要重编译的 LaTeX 警告信号，本次迭代稳定"
msgstr "No recompile warnings; stable"

msgid "日志检测到重编译警告，要求多次迭代编译"
msgstr "Recompile warnings found"

msgid "检测报告"
msgstr "Detection report"

msgid "第"
msgstr "Pass"

msgid "轮"
msgstr " round"

msgid "结论："
msgstr "Conclusion: "

#, python-format
msgid "无需额外执行 %(prog)s 编译。"
msgstr "No additional %(prog)s compilation passes needed."

#, python-format
msgid "本次累计编译总次数：%(total)s 次"
msgstr "Total compilation passes this run: %(total)s"

#, python-format
msgid "需额外进行 %(next)s 次 %(prog)s 编译。"
msgstr "%(next)s additional %(prog)s compilation passes required."

#, python-format
msgid "已达 %(max_extra)s 次额外编译安全上限，停止调度。"
msgstr ""
"Reached the safety limit of %(max_extra)s additional compilation passes, "
"stopping scheduling."

