msgid "文件名中不能存在路径"
msgstr "File name must not contain a path"

#, python-format
msgid "文件类型非 %(args)s: "
msgstr "File type is not %(args)s: "

msgid "搜索到: "
msgstr "Found: "

msgid "文件数目: "
msgstr "Number of files: "

msgid "文件不存在于当前路径下，请检查终端显示路径是否是项目路径"
msgstr ""
"File does not exist in the current directory, please verify that the "
"terminal path is the project directory"

msgid "当前终端路径: "
msgstr "Current terminal path: "

msgid "文件搜索失败: "
msgstr "File search failed: "

msgid "通过特征命令检索到主文件: "
msgstr "Main file detected via characteristic commands: "

msgid "打开文件失败: "
msgstr "Failed to open file: "

msgid "发现主文件数量: "
msgstr "Number of main files found: "

msgid "终端路径下不存在主文件!请检查终端显示路径是否是项目路径!"
msgstr ""
"No main file found in the terminal directory! Please verify that the "
"terminal path is the project directory!"

msgid "通过命令行命令指定待编译主文件为: "
msgstr "Main file to compile specified via command line: "

msgid "通过根目录下唯一主文件指定待编译主文件为: "
msgstr ""
"Main file to compile specified by the unique main file in the root "
"directory: "

msgid "魔法注释 % !TEX root 在当前根目录下主文件中有被定义"
msgstr ""
"Magic comment % !TEX root is defined in the main file under the current "
"root directory"

msgid "魔法注释 % !TEX root 只存在于: "
msgstr "Magic comment % !TEX root only exists in: "

msgid "通过魔法注释 % !TEX root 指定待编译主文件为: "
msgstr "Main file to compile specified via magic comment % !TEX root: "

msgid "魔法注释 % !TEX root 指定的文件名与当前文件名不同, 无法确定主文件: "
msgstr ""
"The file name specified by magic comment % !TEX root differs from the "
"current file name, cannot determine the main file: "

msgid "魔法注释 % !TEX root 在当前根目录下的多个主文件中同时被定义, 无法根据魔法注释确定待编译主文件"
msgstr ""
"Magic comment % !TEX root is defined in multiple main files under the "
"current root directory, cannot determine the main file to compile based "
"on magic comments"

msgid "无法根据魔法注释判断出待编译主文件, 尝试根据默认主文件名指定待编译主文件"
msgstr ""
"Cannot determine the main file to compile from magic comments, attempting"
" to specify it by default main file name"

#, python-format
msgid "通过默认文件名 \"%(args)s.tex\" 指定待编译主文件为: "
msgstr "Main file to compile specified via default file name \"%(args)s.tex\": "

#, python-format
msgid "当前根目录下不存在名为 \"%(args)s.tex\" 的文件"
msgstr "No file named \"%(args)s.tex\" exists in the current root directory"

msgid "无法进行编译, 当前根目录下存在多个主文件: "
msgstr "Cannot compile, multiple main files exist in the current root directory: "

#, python-format
msgid ""
"请修改待编译主文件名为默认文件名 \"%(args)s.tex\" 或在文件中加入魔法注释 \"% !TEX root = [待编译主文件名]\""
" 或在终端输入 \"pytexmk [待编译主文件名]\" 进行编译, 或删除当前根目录下多余的 tex 文件"
msgstr ""
"Please rename the main file to compile to the default name "
"\"%(args)s.tex\", or add the magic comment \"% !TEX root = [main file "
"name]\" in the file, or run \"pytexmk [main file name]\" in the terminal "
"to compile, or remove excess tex files from the current root directory"

msgid "当前根目录是: "
msgstr "Current root directory: "

msgid "草稿模式未启用, 跳过处理."
msgstr "Draft mode not enabled, skipping processing."

msgid "启用草稿模式"
msgstr "Draft mode enabled"

msgid "关闭草稿模式"
msgstr "Draft mode disabled"

#, python-format
msgid "处理文件: %(args)s, 文件大小: %(size).3f MB"
msgstr "Processing file: %(args)s, file size: %(size).3f MB"

msgid "未匹配到内容, 文件未修改."
msgstr "No matching content found, file not modified."

msgid "文件未找到: "
msgstr "File not found: "

msgid "权限错误: 无法读取或写入文件: "
msgstr "Permission error: cannot read or write file: "

msgid "更新草稿模式时出错: "
msgstr "Error updating draft mode: "

