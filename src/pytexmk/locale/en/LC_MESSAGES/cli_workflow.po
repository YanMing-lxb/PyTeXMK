msgid "清除所有的辅助文件"
msgstr "Clean all aux files"

msgid "清除文件夹内输出文件"
msgstr "Clean folder outputs"

msgid "[bold green]已完成清除所有带辅助文件后缀的文件和主文件输出文件的指令[/bold green]"
msgstr ""
"[bold green]Finished cleaning all auxiliary-extension files and main file"
" outputs[/bold green]"

msgid "[bold green]已完成清除所有带辅助文件后缀的文件的指令[/bold green]"
msgstr "[bold green]Finished cleaning all auxiliary-extension files[/bold green]"

msgid "修复 PDF 文件"
msgstr "Repair PDF"

msgid "清除文件夹内辅助文件"
msgstr "Clean folder aux"

msgid "清除根目录内辅助文件"
msgstr "Clean root aux"

msgid "[bold green]已完成清除所有主文件的辅助文件和输出文件的指令[/bold green]"
msgstr ""
"[bold green]Finished cleaning auxiliary and output files of all main "
"files[/bold green]"

msgid "[bold green]已完成清除所有主文件的辅助文件的指令[/bold green]"
msgstr ""
"[bold green]Finished cleaning auxiliary files of all main files[/bold "
"green]"

msgid "开始预处理"
msgstr "Starting preprocessing"

msgid "辅助文件->根目录"
msgstr "Aux files -> root"

msgid "未检测到已有辅助文件，进行初始化"
msgstr "No existing auxiliary files detected, initializing"

#, python-format
msgid "已检测到 %(n)s 个已有辅助文件"
msgstr "Detected %(n)s existing auxiliary files"

msgid "没有检测到可迁移的辅助文件"
msgstr "No migratable auxiliary files detected"

#, python-format
msgid "已移动 %(n)s 个辅助文件到项目根目录"
msgstr "Moved %(n)s auxiliary files to project root directory"

msgid "开始后处理"
msgstr "Starting post-processing"

msgid "移动结果文件到输出目录..."
msgstr "Moving result files to output directory..."

msgid "结果文件->输出目录"
msgstr "Result -> output"

msgid "移动辅助文件到辅助目录..."
msgstr "Moving auxiliary files to auxiliary directory..."

msgid "辅助文件->辅助目录"
msgstr "Aux files -> aux dir"

msgid "警告：检测到上次编译可能被中断，辅助文件可能不完整。"
msgstr ""
"Warning: the previous compilation may have been interrupted; auxiliary "
"files may be incomplete."

msgid "建议先运行 [bold cyan]pytexmk -c[/bold cyan] 清理后再重试。[/yellow]"
msgstr ""
"It is recommended to run [bold cyan]pytexmk -c[/bold cyan] to clean up "
"first, then retry.[/yellow]"

msgid "可运行 pytexmk -ls 同步子项目清单, 或检查根配置 \\[subprojects\\] 段"
msgstr ""
"Run pytexmk -ls to sync the subproject list, or check the "
"\\[subprojects\\] section in the root config"

msgid "子项目调用: 忽略子项目目录下的本地 .pytexmkrc, 以根配置为准"
msgstr ""
"Subproject invocation: ignore the local .pytexmkrc under the subproject "
"directory, root config takes precedence"

msgid "非安静模式运行"
msgstr "Running in non-quiet mode"

msgid "提取魔法注释: "
msgstr "Extracting magic comments: "

msgid "通过魔法注释设置程序为: "
msgstr "Program set via magic comment: "

msgid "通过魔法注释设置输出目录: "
msgstr "Output directory set via magic comment: "

msgid "通过魔法注释设置辅助目录: "
msgstr "Auxiliary directory set via magic comment: "

msgid "通过配置文件设置默认文件为: "
msgstr "Default file set via config file: "

msgid "通过配置文件设置编译器为: "
msgstr "Compiler set via config file: "

msgid "通过配置文件设置安静模式为: "
msgstr "Quiet mode set via config file: "

msgid "通过配置文件设置输出目录为: "
msgstr "Output directory set via config file: "

msgid "通过配置文件设置辅助目录为: "
msgstr "Auxiliary directory set via config file: "

msgid "通过配置文件设置 PDF 预览为: "
msgstr "PDF preview set via config file: "

msgid "通过配置文件设置 PDF 预览器为: "
msgstr "PDF viewer set via config file: "

msgid "通过配置文件设置 LaTeXDiff 旧文件为: "
msgstr "LaTeXDiff old file set via config file: "

msgid "通过配置文件设置 LaTeXDiff 新文件为: "
msgstr "LaTeXDiff new file set via config file: "

msgid "通过配置文件设置 LaTeXDiff 对比文件为: "
msgstr "LaTeXDiff comparison file set via config file: "

#, python-format
msgid "LaTeXDiff 需恰好 2 个文件名，当前收到 %(n)s 个"
msgstr "LaTeXDiff requires exactly 2 file names, received %(n)s"

#, python-format
msgid "LaTeXDiff-compile 需恰好 2 个文件名，当前收到 %(n)s 个"
msgstr "LaTeXDiff-compile requires exactly 2 file names, received %(n)s"

msgid "命令行未指定 LaTeXDiff 相关参数"
msgstr "No LaTeXDiff-related parameters specified on the command line"

msgid "根据配置文件设置 LaTeXDiff 新 TeX 文件为: "
msgstr "LaTeXDiff new TeX file set via config file: "

msgid "根据配置文件设置 LaTeXDiff 旧 TeX 文件为: "
msgstr "LaTeXDiff old TeX file set via config file: "

msgid "请在命令行或配置文件中指定新旧两个 TeX 文件"
msgstr ""
"Please specify both the old and new TeX files via the command line or "
"config file"

msgid "[bold green]已生成根项目配置文件 [/bold green]"
msgstr "[bold green]Root project config file generated [/bold green]"

msgid "[bold green]已生成用户配置文件 ~/.pytexmkrc[/bold green]"
msgstr "[bold green]User config file ~/.pytexmkrc generated[/bold green]"

#, python-format
msgid "README.html / README.en.html 文件均未找到，目录: %(args)s"
msgstr ""

msgid "[bold green]正在打开 README 文件...[/bold green]"
msgstr "[bold green]Opening README file...[/bold green]"

#, python-format
msgid "README 本地路径: %(args)s"
msgstr "README local path: %(args)s"

msgid "打开 README 文件出错: "
msgstr "Error opening README file: "

msgid "[bold green]已更新 .pytexmkrc 中的 \\[subprojects\\] 段[/bold green]"
msgstr ""
"[bold green]Updated the \\[subprojects\\] section in .pytexmkrc[/bold "
"green]"

msgid "[yellow]未找到根 .pytexmkrc , 请先运行 pytexmk -i 后再运行 -ls[/yellow]"
msgstr ""
"[yellow]Root .pytexmkrc not found, please run pytexmk -i first before "
"running -ls[/yellow]"

msgid "不能对同一个文件进行比较, 请检查文件名是否正确"
msgstr ""
"Cannot compare the same file with itself, please verify the file names "
"are correct"

msgid "LaTeXDiff 预处理"
msgstr "LaTeXDiff preprocessing"

msgid "全辅助文件->根目录"
msgstr "All aux -> root"

msgid ""
"请输入 LaTeXDiff 的显示风格：\n"
"  1 - 显示参考文献/符号说明的修改\n"
"  2 - 不显示参考文献/符号说明的修改\n"
"请选择 (1 或者 2): "
msgstr ""
"Please select LaTeXDiff display style:\n"
"  1 - Show changes in bibliography/symbol descriptions\n"
"  2 - Do not show changes in bibliography/symbol descriptions\n"
"Please choose (1 or 2): "

msgid "LaTeXDiff 运行"
msgstr "LaTeXDiff run"

msgid "LaTeXDiff 后处理"
msgstr "LaTeXDiff post-processing"

msgid "删除 Flatten 后的文件..."
msgstr "Remove flattened files"

msgid "开始预处理命令"
msgstr "Starting preprocessing commands"

msgid ""
"请输入正确的选项 (1 或者 2)\n"
"  1 - 显示参考文献/符号说明的修改\n"
"  2 - 不显示参考文献/符号说明的修改"
msgstr ""
"Please enter a valid option (1 or 2)\n"
"  1 - Show changes in bibliography/symbol descriptions\n"
"  2 - Do not show changes in bibliography/symbol descriptions"

msgid "LaTeXDiff 编译出错: "
msgstr "LaTeXDiff compilation error: "

