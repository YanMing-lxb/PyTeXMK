msgid ""
"缺少 %(p)s\n"
"按后缀兜底收集（可能混入未引用文件），建议先编译一次"
msgstr ""
"Missing %(p)s\n"
"Dependencies come from a suffix scan (unreferenced files may sneak in); "
"compile once first"

msgid "PDF 一致性"
msgstr "PDF freshness"

#, python-format
msgid "PDF 早于 %(n)s 个源文件（如 %(f)s），建议重编译后再重新打包。"
msgstr ""
"PDF is older than %(n)s source file(s) (e.g. %(f)); recompile, then "
"repack."

msgid "PDF 产物"
msgstr "PDF output"

#, python-format
msgid "未找到 %(p)s，包内不带 PDF；建议先编译再打包"
msgstr ""
"No %(p)s found; the pack has no PDF — compile once, then repack"

msgid "产物检查"
msgstr "Artifacts"

msgid "通过：.fls 齐全，PDF 不旧于入包源码"
msgstr "OK: .fls present, PDF not older than packed sources"

msgid "宏包"
msgstr "Packages"

msgid "扫描解析"
msgstr "Scan"

msgid "计数：c 字符 / f 文件 / p 宏包"
msgstr "Counts: c chars / f files / p packages"

