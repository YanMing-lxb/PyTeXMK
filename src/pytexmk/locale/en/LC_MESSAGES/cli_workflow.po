msgid "%(args)s 的辅助文件不存在, 请检查编译"
msgstr "Auxiliary files for %(args)s do not exist, please check compilation"

#, python-format
msgid "PyTeXMK 版本: %(version)s"
msgstr "PyTeXMK version: %(version)s"

msgid "[bold green]PyTeXMK 开始运行...[/bold green]"
msgstr "[bold green]PyTeXMK starting...[/bold green]"

