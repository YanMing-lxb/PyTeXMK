msgid ""
"\n"
"魔法注释：只扫描每个主文件的前 50 行，可指定编译引擎、根文件、输出目录和辅助目录。\n"
msgstr ""
"\n"
"Magic comments: only the first 50 lines of each main file are scanned; "
"they set the compiler, root file, output directory, and auxiliary "
"directory.\n"

msgid "[i]LaTeX 辅助编译程序  ---- 焱铭[/]"
msgstr "[i]LaTeX auxiliary compiler  ---- Yanming[/]"

msgid "提示：运行出错时会直接说明原因与下一步；问题反馈：https://github.com/YanMing-lxb/PyTeXMK/issues"
msgstr ""
"Note: on failure PyTeXMK states the reason and the next step; report "
"issues at https://github.com/YanMing-lxb/PyTeXMK/issues"

msgid "显示版本并退出"
msgstr "Show version and exit"

msgid "显示本帮助并退出"
msgstr "Show this help and exit"

msgid "从最近一次编译日志生成报告（不触发编译）"
msgstr "Generate a report from the latest compile log (does not compile)"

msgid "用 PdfLaTeX 编译"
msgstr "Compile with PdfLaTeX"

msgid "用 XeLaTeX 编译"
msgstr "Compile with XeLaTeX"

msgid "用 LuaLaTeX 编译"
msgstr "Compile with LuaLaTeX"

msgid "草稿模式：跳过图片加载，编译更快"
msgstr "Draft mode: skip image loading for faster compiles"

msgid "清除当前主文件的辅助文件（仅辅助目录）"
msgstr "Clean auxiliary files of the current main file (auxiliary directory only)"

msgid "清除当前主文件的辅助文件与输出文件（辅助目录 + 根目录）"
msgstr ""
"Clean auxiliary and output files of the current main file (auxiliary + "
"root directory)"

msgid "递归清理全项目的辅助文件（不要求唯一主文件）"
msgstr ""
"Recursively clean auxiliary files across the project (no unique main file"
" required)"

msgid "递归清理全项目的辅助文件与主文件输出"
msgstr "Recursively clean auxiliary files and main-file outputs across the project"

msgid "实时显示 TeX/biber/makeindex 的输出"
msgstr ""
"Stream TeX/biber/makeindex output (overrides quiet_mode; leaves "
"-interaction unchanged)"

msgid "向引擎追加一个参数，可重复（如 -pa=-8bit）"
msgstr "Pass an extra argument to the engine; repeatable (e.g. -pa=-8bit)"

msgid "生成期刊投稿包 zip（按 .fls 收集依赖，附全部 .bib，默认不含 .bbl）"
msgstr ""

msgid "监视源文件并自动重编（Ctrl+C 退出）"
msgstr "Watch sources and recompile automatically (Ctrl+C to quit)"

msgid "只显示本次编译配置，不编译"
msgstr "Show the effective build configuration without compiling"

msgid "显示合并后的配置（默认 < 用户 < 项目）"
msgstr "Show the merged configuration (default < user < project)"

msgid "编译根配置 \\[subprojects] 中的全部子项目"
msgstr "Compile every subproject listed in the root config's \\[subprojects]"

msgid "显示详细运行信息"
msgstr "Show detailed runtime information"

msgid "修复被项目真实引用的 PDF（按 .fls 判定范围）。不带文件名时只修复被引用的文件；可指定一个或多个 PDF"
msgstr ""
"Repair PDFs actually referenced by the project (scope from .fls). With no"
" file names only referenced PDFs are repaired; one or more PDFs may be "
"given"

msgid "忽略构建缓存，强制重新编译"
msgstr "Ignore the build cache and force a rebuild"

msgid ""
"编译后打开 PDF 预览。指定 FILE_NAME 时只打开该文件（限输出目录），不再编译；主文件名可写在 document 位置，如 "
"pytexmk main -pv"
msgstr ""
"Open the PDF after compiling. With FILE_NAME only that file is opened "
"(output directory only) and nothing is compiled; the main file may be "
"given as the document argument, e.g. pytexmk main -pv"

msgid "编译根配置 \\[subprojects] 中指定的子项目"
msgstr "Compile the subprojects selected in the root config's \\[subprojects]"

msgid "列出并写回根配置的 \\[subprojects] 清单"
msgstr ""
"List subprojects and write the list back to the root config's "
"\\[subprojects]"

msgid "生成项目配置 .pytexmkrc（覆盖已有文件）"
msgstr "Create a project .pytexmkrc (overwrites an existing file)"

msgid "生成用户配置 ~/.pytexmkrc（覆盖已有文件）"
msgstr "Create a user ~/.pytexmkrc (overwrites an existing file)"

msgid "待编译主文件名"
msgstr "Main file name to compile"

#, python-format
msgid "不支持把短开关合并写成 %(token)s，请分开书写（如 -d -c）"
msgstr ""
"Short flags cannot be combined as %(token)s; write them separately (e.g. "
"-d -c)"

#~ msgid "生成期刊投稿包 zip（按 .fls 收集依赖，并处理 Unicode）"
#~ msgstr ""
#~ "Build a journal submission zip (collects"
#~ " dependencies from .fls and handles "
#~ "Unicode)"

#~ msgid "打包后用 pdflatex 试编译一次做验证"
#~ msgstr "Test-compile the package once with pdflatex"

#~ msgid "投稿包同时包含 .bib 源文件（默认只带 .bbl）"
#~ msgstr "Include .bib sources in the submission package (default: only .bbl)"

